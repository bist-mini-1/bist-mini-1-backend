<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bist.mini.dao.SampleDAO">

    <!-- 샘플 엔티티 결과 매핑 -->
    <resultMap id="SampleResultMap" type="com.bist.mini.entity.Sample">
        <id property="id" column="sample_id" />
        <result property="testStr" column="test_str" />
    </resultMap>

    <!-- 전체 목록 조회 예시 -->
    <select id="findAll" resultMap="SampleResultMap">
        SELECT 
            sample_id,
            test_str
        FROM SAMPLE_TABLE
        ORDER BY sample_id DESC
    </select>

    <!-- 상세 조회 예시 -->
    <select id="findById" parameterType="long" resultMap="SampleResultMap">
        SELECT 
            sample_id,
            test_str
        FROM SAMPLE_TABLE
        WHERE sample_id = #{id}
    </select>

</mapper>
