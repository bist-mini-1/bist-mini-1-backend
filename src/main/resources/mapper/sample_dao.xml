<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bist.mini.sample.dao.SampleDAO">

    <!-- 샘플 엔티티 결과 매핑 -->
    <resultMap id="SampleResultMap" type="com.bist.mini.sample.entity.Sample">
        <id property="id" column="SAMPLE_ID" />
        <result property="testStr" column="TESTSTR" />
    </resultMap>

    <!-- 전체 목록 조회 예시 -->
    <select id="findAll" resultMap="SampleResultMap">
        SELECT 
            SAMPLE_ID,
            TESTSTR
        FROM SAMPLE
        ORDER BY SAMPLE_ID ASC
    </select>

    <!-- 상세 조회 예시 -->
    <select id="findById" parameterType="long" resultMap="SampleResultMap">
        SELECT 
            SAMPLE_ID,
            TESTSTR
        FROM SAMPLE
        WHERE SAMPLE_ID = #{id}
    </select>

    <!-- 샘플 등록 -->
    <insert id="insert" parameterType="com.bist.mini.sample.entity.Sample">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT SEQ_SAMPLE_ID.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO SAMPLE (
            SAMPLE_ID,
            TESTSTR
        ) VALUES (
            #{id},
            #{testStr}
        )
    </insert>

</mapper>
